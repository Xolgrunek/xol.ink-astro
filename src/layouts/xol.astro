---
export interface Props {
	title: string;
}

const { title } = Astro.props;

---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Xol's Link Page">
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="darkreader-lock">
		<title>{title}</title>
		<meta name='impact-site-verification' value='3c5e9a38-332a-435c-bb28-a2db03edd2ec'>
		<script defer data-project="67c1039e97d306c7139d540f" src="https://cdn.jsdelivr.net/gh/litlyx/litlyx-js/browser/litlyx.js"></script>
	</head>
	<body class="dark:bg-black">
		<slot />

	</body>
</html>
<style is:global>
    body {
    background:

    linear-gradient(
        rgba(0,0,0,0.5),
        rgba(0,0,0,0.5)
    ),
     url('/profiles/xol/xolbackground4.jpg') no-repeat center center fixed;
    background-size:cover;
}
	:root {
		--accent: 124, 58, 237;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), rgb(90, 2, 90) 30%, white 60%);
	}

	/* HTML: <div class="wavy-box"></div> */
.starburst {
  width: 200px; /* adjust to control the size */
  aspect-ratio: 1;
  clip-path: polygon(100% 50%,78.98% 57.76%,93.3% 75%,71.21% 71.21%,75% 93.3%,57.76% 78.98%,50% 100%,42.24% 78.98%,25% 93.3%,28.79% 71.21%,6.7% 75%,21.02% 57.76%,0% 50%,21.02% 42.24%,6.7% 25%,28.79% 28.79%,25% 6.7%,42.24% 21.02%,50% 0%,57.76% 21.02%,75% 6.7%,71.21% 28.79%,93.3% 25%,78.98% 42.24%);
}

</style>
